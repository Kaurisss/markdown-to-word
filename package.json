{
  "name": "markdown-to-word",
  "private": true,
  "version": "2.0.2",
  "type": "module",
  "scripts": {
    "dev": "pnpm run generate:tokens && vite --port 3000 --strictPort",
    "dev:tauri": "tauri dev",
    "build": "pnpm run generate:tokens && vite build",
    "build:tauri": "pnpm run build && tauri build",
    "build:installer": "iscc scripts/inno-setup.iss",
    "build:backend": "node scripts/build-python.js",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist node_modules/.vite src-tauri/target",
    "rebuild": "pnpm run clean && pnpm run build && pnpm run build:tauri",
    "test": "vitest --run",
    "generate:tokens": "node scripts/generate-css-tokens.js"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@hookform/resolvers": "^5.4.0",
    "@lobehub/icons": "^5.10.0",
    "@mingcute/react": "^1.4.1",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-shell": "2.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docx": "^9.5.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.40.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.79.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "textarea-caret": "^3.1.0",
    "unified": "^11.0.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/cli": "^2.9.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.3",
    "@types/textarea-caret": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fast-check": "^4.4.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "rimraf": "^6.0.1",
    "sharp-cli": "^5.2.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.16"
